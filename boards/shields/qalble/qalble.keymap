#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q     &kp W    &kp E     &kp R     &kp T     &kp Y     &kp U     &kp I     &kp O     &kp P
                &kp A     &kp S    &kp D     &kp F     &kp G     &kp H     &kp J     &kp K     &kp L     &kp RET
                &kp Z     &kp X    &kp C     &kp V     &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp LSHFT
                &kp LCTRL &kp LALT &mo 1     &kp SPACE &kp SPACE &kp SPACE &mo 1     &kp BSPC  &kp DEL   &kp ESC
            >;
        };

        fn_layer {
            bindings = <
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR &out OUT_TOG &kp N7    &kp N8    &kp N9    &kp N0    &bootloader
                &out OUT_USB &out OUT_BLE &trans       &trans     &trans       &kp N4    &kp N5    &kp N6    &kp PLUS  &kp MINUS
                &trans       &trans       &trans       &trans     &trans       &kp N1    &kp N2    &kp N3    &kp DOT   &trans
                &trans       &trans       &trans       &trans     &trans       &trans    &trans    &trans    &trans    &trans
            >;
        };
    };
};