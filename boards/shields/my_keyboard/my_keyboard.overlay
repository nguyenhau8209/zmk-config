#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        /* Khai báo 4 Hàng */
        row-gpios
            = <&gpio1 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* D2: P1.02 */
            , <&gpio0 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* D3: P0.06 */
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* D4: P0.29 */
            , <&gpio0 27 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* D5: P0.27 */
            ;

        /* Khai báo 10 Cột */
        col-gpios
            = <&gpio1 8 GPIO_ACTIVE_HIGH>   /* D7:  P1.08 */
            , <&gpio0 7 GPIO_ACTIVE_HIGH>   /* D9:  P0.07 */
            , <&gpio0 5 GPIO_ACTIVE_HIGH>   /* D10: P0.05 */
            , <&gpio0 26 GPIO_ACTIVE_HIGH>  /* D11: P0.26 */
            , <&gpio0 11 GPIO_ACTIVE_HIGH>  /* D12: P0.11 */
            , <&gpio0 12 GPIO_ACTIVE_HIGH>  /* D13: P0.12 */
            , <&gpio0 25 GPIO_ACTIVE_HIGH>  /* D0:  P0.25 (RX) */
            , <&gpio0 24 GPIO_ACTIVE_HIGH>  /* D1:  P0.24 (TX) */
            , <&gpio1 6 GPIO_ACTIVE_HIGH>   /* 38:  P1.06 */
            , <&gpio1 7 GPIO_ACTIVE_HIGH>   /* 39:  P1.07 */
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9)
        >;
    };
};